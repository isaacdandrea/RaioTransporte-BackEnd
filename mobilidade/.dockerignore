# Ignore Git metadata and local development files
.git
.gitignore
.gitattributes

# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Compiled extensions
*.so

# Local environment & secrets
.env
.env.*
.venv/
venv/
ENV/
*.egg-info/
*.sqlite3

# Editor / OS junk
*.swp
.DS_Store
Thumbs.db
.idea/
.vscode/

# Development tooling not required inside the image
docker-compose.yml
environment.yml
scripts/
coverage/
htmlcov/
pytest_cache/

# Runtime artefacts generated by collectstatic/media uploads
staticfiles/
media/
*.log

# Local testing utilities and visualisation artefacts
**/tests/
**/test_*.py
transporte/utils/testar_raio_visual.py
transporte/utils/testar_raio_visual_externo.py
transporte/utils/baixar_osm.py
transporte/utils/extrair_sao_paulo.py
