# --- Django core ---
# Required secret used for cryptographic signing. Generate a long random value before deploying.
SECRET_KEY=change-me-in-production

# Enable Django debug outputs. Always disable in production.
DEBUG=False

# Override only if you need a different settings module (e.g. mobilidade.settings_prod).
DJANGO_SETTINGS_MODULE=mobilidade.settings

# --- API authentication ---
# Primary shared secret used by client applications (e.g. Flutter) to call the API.
API_SHARED_SECRET=
# Optional comma-separated list of additional secrets to support key rotation or multiple clients.
API_SHARED_SECRETS=

# --- Hosts & CORS ---
# Comma-separated list of hostnames that Django will accept requests from.
ALLOWED_HOSTS=localhost,127.0.0.1

# Default origins cover local Flutter/web debugging targets. Override per deployment.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://10.0.2.2:8080
# Allow Cloud Run preview URLs while custom domains are pending. Adjust or clear as needed.
CORS_ALLOWED_ORIGIN_REGEXES=^https://[\w-]+-[\w-]+-[\w-]+-a\.run\.app$
# Explicitly opt-in to allowing every origin. Prefer configuring the specific lists above.
CORS_ALLOW_ALL_ORIGINS=False

# CSRF trusted origins must include any HTTPS domains that post to Django endpoints.
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Individual database settings used when DATABASE_URL is empty.
DB_NAME=mobilidadenew
DB_USER=mobilidade
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433
# Maximum seconds to persist database connections. Increase for production deployments.
DB_CONN_MAX_AGE=60

# Optional full connection URL (takes precedence over the DB_* fields above).
DATABASE_URL=

# --- Production security ---
# Redirect all requests to HTTPS when running behind a proxy that terminates TLS.
SECURE_SSL_REDIRECT=True
# Cache duration (in seconds) for static files served by WhiteNoise.
WHITENOISE_MAX_AGE=2592000

# --- Gunicorn (container/server runtime) ---
# Port that the application listens on. Cloud Run injects $PORT automatically.
PORT=8080
# Optional performance tuning knobs. Leave blank to let Gunicorn auto-detect.
WEB_CONCURRENCY=
GUNICORN_THREADS=
GUNICORN_TIMEOUT=
GUNICORN_WORKER_CLASS=
